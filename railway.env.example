# =============================================================================
# Переменные для панели Railway (Variables → Raw Editor).
# НЕ копируйте в локальный .env — локально остаётся SQLite (.env.example).
# =============================================================================
#
# 1. Создайте сервис PostgreSQL в проекте Railway.
# 2. В сервисе Laravel: Settings → Variables → вставьте блок ниже.
# 3. Подключите Postgres: Add Reference → DATABASE_URL (или скопируйте URL в DB_URL).
# 4. APP_KEY: сгенерируйте локально: php artisan key:generate --show
# 5. APP_URL: домен сервиса после Generate Domain.
#
# Синтаксис ${{Postgres.DATABASE_URL}} — подстановка из связанного сервиса Postgres.

APP_NAME="МотоШоп"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service.up.railway.app

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- PostgreSQL (обязательно на Railway) ---
DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}

# Альтернатива, если платформа отдаёт только DATABASE_URL:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

DB_SSLMODE=require

# --- Laravel (сессии и кэш в БД, как локально) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# --- Почта (по желанию) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Деплой (railway.toml / railway.json):
#   preDeploy: migrate + DeploySeeder (идемпотентный) + storage:link
#   start:     php artisan serve на $PORT
# Админ после первого деплоя: login admin / password admin
# =============================================================================
